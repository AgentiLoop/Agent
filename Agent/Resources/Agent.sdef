<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Agent! Terminology" xmlns:xi="http://www.w3.org/2003/XInclude">

    <!-- Standard Suite (open, close, quit, count, exists, get/set, windows …) -->
    <xi:include href="file:///System/Library/ScriptingDefinitions/CocoaStandard.sdef" xpointer="xpointer(/dictionary/suite)"/>

    <suite name="Agent! Suite" code="Agnt" description="Control Agent! — run and stop tasks, read the activity log, set the project folder.">

        <class-extension extends="application" description="Agent! application.">
            <property name="task running" code="AgRn" type="boolean" access="r"
                      description="Whether the Main tab is currently running a task.">
                <cocoa key="taskRunning"/>
            </property>
            <property name="activity log" code="AgLg" type="text" access="r"
                      description="Full text of the Main tab activity log.">
                <cocoa key="activityLog"/>
            </property>
            <property name="task summary" code="AgLR" type="text" access="r"
                      description="Completion summary of the Main tab's most recent task (empty while running, after a stop, or before any task).">
                <cocoa key="lastResult"/>
            </property>
            <property name="task error" code="AgLE" type="text" access="r"
                      description="Last error logged by the Main tab's most recent task (empty when none).">
                <cocoa key="lastError"/>
            </property>
            <property name="prompt history" code="AgHp" access="r"
                      description="Prompts submitted in the Main tab, oldest first (the task field's ↑ history).">
                <type type="text" list="yes"/>
                <cocoa key="promptHistory"/>
            </property>
            <property name="task history" code="AgHt" access="r"
                      description="Recent task summaries, &quot;[time] prompt → summary&quot;, oldest first (History window, Task Summaries).">
                <type type="text" list="yes"/>
                <cocoa key="taskHistory"/>
            </property>
            <property name="error history" code="AgHe" access="r"
                      description="Recent errors, &quot;[time] type: message&quot;, oldest first (History window, Error History).">
                <type type="text" list="yes"/>
                <cocoa key="errorHistory"/>
            </property>
            <property name="project folder" code="AgPF" type="text"
                      description="The Main tab project folder (absolute path).">
                <cocoa key="projectFolder"/>
            </property>
            <property name="task input" code="AgTI" type="text"
                      description="The Main tab task field text.">
                <cocoa key="taskInput"/>
            </property>
            <property name="provider" code="AgPv" type="text"
                      description="Display name of the Main tab LLM provider. Set it to a provider name (e.g. &quot;Claude&quot;) to switch.">
                <cocoa key="providerName"/>
            </property>
            <property name="model" code="AgMd" type="text"
                      description="The Main tab LLM model ID. Setting it changes the selected model for the Main tab's provider.">
                <cocoa key="modelName"/>
            </property>
            <!-- Settings (same values as the Settings window, persisted) -->
            <property name="max iterations" code="AgMI" type="integer"
                      description="Maximum LLM turns per task (1 or more).">
                <cocoa key="maxIterations"/>
            </property>
            <property name="max retries" code="AgMR" type="integer"
                      description="Maximum retries after a failed LLM request.">
                <cocoa key="maxRetries"/>
            </property>
            <property name="max tokens" code="AgMT" type="integer"
                      description="Maximum output tokens per response (0 = provider default).">
                <cocoa key="maxTokens"/>
            </property>
            <property name="token budget" code="AgTB" type="integer"
                      description="Per-task token budget, input + output (0 = unlimited).">
                <cocoa key="tokenBudget"/>
            </property>
            <property name="temperature" code="AgTm" type="real"
                      description="Temperature (0–2) of the Main tab's provider.">
                <cocoa key="temperature"/>
            </property>
            <property name="reasoning effort" code="AgRE" type="text"
                      description="Reasoning effort: off, low, medium or high.">
                <cocoa key="reasoningEffort"/>
            </property>
            <property name="auto verify" code="AgAV" type="boolean"
                      description="After a successful build, launch the app and run accessibility checks.">
                <cocoa key="autoVerify"/>
            </property>
            <property name="critic review" code="AgCR" type="boolean"
                      description="Have the LLM review the task's diff before the task can complete.">
                <cocoa key="criticReview"/>
            </property>
            <property name="visual tests" code="AgVT" type="boolean"
                      description="Allow the LLM to define click/verify UI tests.">
                <cocoa key="visualTests"/>
            </property>
            <property name="auto pull request" code="AgPR" type="boolean"
                      description="After a task completes, create a branch, commit, push and open a pull request.">
                <cocoa key="autoPR"/>
            </property>
            <property name="auto scaffold" code="AgSc" type="boolean"
                      description="Allow the LLM to create new Xcode projects from templates.">
                <cocoa key="autoScaffold"/>
            </property>
            <property name="auto screenshot" code="AgSS" type="boolean"
                      description="Take a screenshot after UI actions.">
                <cocoa key="autoScreenshot"/>
            </property>
            <property name="force vision" code="AgFV" type="boolean"
                      description="Send images to every provider.">
                <cocoa key="forceVision"/>
            </property>
            <property name="messages monitor" code="AgMM" type="boolean"
                      description="Watch Messages for incoming Agent! commands.">
                <cocoa key="messagesMonitor"/>
            </property>
            <property name="task auto complete" code="AgTC" type="boolean"
                      description="Show prompt-history suggestions while typing in the task field.">
                <cocoa key="taskAutoComplete"/>
            </property>
            <property name="user agent enabled" code="AgUA" type="boolean"
                      description="Whether the user Launch Agent is enabled. Setting false shuts it down.">
                <cocoa key="userAgentEnabled"/>
            </property>
            <property name="launch daemon enabled" code="AgLD" type="boolean"
                      description="Whether the root Launch Daemon is enabled. Setting false shuts it down.">
                <cocoa key="launchDaemonEnabled"/>
            </property>
            <property name="accessibility automation" code="AgAx" type="boolean"
                      description="Accessibility Automation switch (Settings &gt; Accessibility). Off blocks every accessibility action.">
                <cocoa key="accessibilityAutomation"/>
            </property>
            <!-- HUD options (the toolbar's HUD popover) -->
            <property name="show hud" code="AgV1" type="boolean"
                      description="Show the LLM Output HUD during a task (⌘B).">
                <cocoa key="showHUD"/>
            </property>
            <property name="smooth streaming" code="AgV2" type="boolean"
                      description="Type LLM output out gradually; off shows it at once.">
                <cocoa key="smoothStreaming"/>
            </property>
            <property name="terminal speed" code="AgV3" type="text"
                      description="HUD typing speed: Normal, Fast, Faster, Blazing or Ludicrous.">
                <cocoa key="terminalSpeed"/>
            </property>
            <property name="scan lines" code="AgV4" type="boolean"
                      description="Draw scan lines over the HUD.">
                <cocoa key="scanLines"/>
            </property>
            <property name="activity log below hud" code="AgV5" type="boolean"
                      description="Start the activity log below the HUD instead of behind it.">
                <cocoa key="hudLogBelow"/>
            </property>
            <property name="activity log text size" code="AgW1" type="integer"
                      description="Activity log text size in points, 9 to 36 (View &gt; Bigger / Smaller / Actual Size Text).">
                <cocoa key="activityLogTextSize"/>
            </property>
            <property name="shell timeout" code="AgW2" type="integer"
                      description="Minutes before a hung shell command is killed, 1 to 120; 0 turns the timeout off.">
                <cocoa key="shellTimeout"/>
            </property>
            <property name="network retry delay" code="AgW3" type="integer"
                      description="Settings &gt; Agent Options: seconds between network retries — 10, 20, 30, 40, 50 or 60.">
                <cocoa key="networkRetryDelay"/>
            </property>
            <property name="output lines" code="AgW4" type="integer"
                      description="Settings &gt; Agent Options: tool output lines kept before truncating — 10, 50, 75, 100, 150, 200, 250, 500, 750, 1000 or 1500.">
                <cocoa key="outputLines"/>
            </property>
            <property name="read file preview lines" code="AgW5" type="integer"
                      description="Settings &gt; Agent Options: lines shown when a file is read — 3, 10, 50, 100, 250, 500, 750 or 1000.">
                <cocoa key="readFilePreviewLines"/>
            </property>
            <property name="capture script stderr" code="AgW6" type="boolean"
                      description="Settings &gt; Agent Options: AgentScript runs capture stderr.">
                <cocoa key="captureScriptStderr"/>
            </property>
            <property name="exa api key" code="AgJ1" type="text" access="w"
                      description="LLM Common Settings &gt; Web Search: Exa API key (write-only; empty clears it).">
                <cocoa key="exaAPIKey"/>
            </property>
            <property name="tavily api key" code="AgJ2" type="text" access="w"
                      description="LLM Common Settings &gt; Web Search: Tavily API key (write-only; empty clears it). DuckDuckGo is used when neither key is set.">
                <cocoa key="tavilyAPIKey"/>
            </property>
            <property name="jev api key" code="AgJ3" type="text" access="w"
                      description="LLM Common Settings &gt; Jev (TypeSafe): API key (write-only; empty clears it).">
                <cocoa key="jevAPIKey"/>
            </property>
            <property name="jev model" code="AgJ4" type="text"
                      description="LLM Common Settings &gt; Jev (TypeSafe): model name. Empty raises an error.">
                <cocoa key="jevModel"/>
            </property>
            <property name="jev advisory" code="AgJ5" type="boolean"
                      description="LLM Common Settings: Consult Jev before tools. Turning it on needs a jev api key.">
                <cocoa key="jevAdvisory"/>
            </property>
            <property name="jev reject percent" code="AgJ6" type="integer"
                      description="LLM Common Settings: Jev blocks a command it rates at least this % destructive — 0 to 100 in steps of 10.">
                <cocoa key="jevRejectPercent"/>
            </property>
            <property name="lm studio protocol" code="AgP1" type="text"
                      description="LM Studio API Protocol: OpenAI Compatible, Anthropic Compatible or LM Studio Native. Changing it resets lm studio endpoint to that protocol's default, like the picker.">
                <cocoa key="lmStudioProtocol"/>
            </property>
            <property name="lm studio endpoint" code="AgP2" type="text"
                      description="LM Studio Endpoint URL (http:// or https://; anything else raises an error).">
                <cocoa key="lmStudioEndpoint"/>
            </property>
            <property name="vllm endpoint" code="AgP3" type="text"
                      description="vLLM Endpoint URL (http:// or https://; anything else raises an error).">
                <cocoa key="vLLMEndpoint"/>
            </property>
            <property name="local ollama endpoint" code="AgP4" type="text"
                      description="Local Ollama Endpoint URL (http:// or https://; anything else raises an error).">
                <cocoa key="localOllamaEndpoint"/>
            </property>
            <property name="openrouter protocol" code="AgP5" type="text"
                      description="OpenRouter API Protocol, one of the picker's choices (e.g. OpenAI Compatible, Anthropic Compatible).">
                <cocoa key="openRouterProtocol"/>
            </property>
            <property name="fluxion protocol" code="AgP6" type="text"
                      description="Fluxion AI API Protocol, one of the picker's choices. Match your key's group: Anthropic-group keys use Anthropic Compatible.">
                <cocoa key="fluxionProtocol"/>
            </property>
            <property name="apple ai mediator" code="AgZ1" type="boolean"
                      description="Apple Intelligence popover: Enable Mediator (master switch for on-device Apple AI).">
                <cocoa key="appleAIMediator"/>
            </property>
            <property name="apple ai triage" code="AgZ2" type="boolean"
                      description="Apple Intelligence popover: answer greetings on-device before the cloud LLM.">
                <cocoa key="appleAITriage"/>
            </property>
            <property name="apple ai annotations" code="AgZ3" type="boolean"
                      description="Apple Intelligence popover: show task summaries and error explanations in the activity log.">
                <cocoa key="appleAIAnnotations"/>
            </property>
            <property name="apple ai token compression" code="AgZ4" type="boolean"
                      description="Apple Intelligence popover: summarize old messages on-device when context runs low.">
                <cocoa key="appleAITokenCompression"/>
            </property>
            <property name="fallback enabled" code="AgB1" type="boolean"
                      description="Settings &gt; Fallback Chain: switch to the next provider when the current one keeps failing.">
                <cocoa key="fallbackEnabled"/>
            </property>
            <property name="fallback chain" code="AgB2"
                      description="Fallback providers in order, each &quot;Provider / model&quot; (e.g. &quot;Claude / claude-sonnet-4&quot;). Setting it replaces the chain; entries already in it keep their on/off switch.">
                <type type="text" list="yes"/>
                <cocoa key="fallbackChain"/>
            </property>
            <property name="disabled fallback entries" code="AgB3"
                      description="Fallback chain entries switched off (skipped); each must be in the fallback chain.">
                <type type="text" list="yes"/>
                <cocoa key="disabledFallbackEntries"/>
            </property>
            <property name="active fallback" code="AgB4" type="text" access="r"
                      description="The fallback entry in use after the primary provider failed, or empty while on the primary.">
                <cocoa key="activeFallback"/>
            </property>
            <property name="system prompt" code="AgS1" type="text"
                      description="Settings &gt; System Prompt: the full prompt template, with its {placeholders}. Setting it saves like the window's Save; it can't be empty.">
                <cocoa key="systemPrompt"/>
            </property>
            <property name="compact system prompt" code="AgS2" type="text"
                      description="Settings &gt; System Prompt: the Apple AI compact prompt template. Setting it saves like the window's Save; it can't be empty.">
                <cocoa key="compactSystemPrompt"/>
            </property>
            <property name="tool groups" code="AgG1" access="r"
                      description="Every tool group name, as in the Tools window.">
                <type type="text" list="yes"/>
                <cocoa key="toolGroups"/>
            </property>
            <property name="tool names" code="AgG2" access="r"
                      description="Every built-in tool name, as in the Tools window.">
                <type type="text" list="yes"/>
                <cocoa key="toolNames"/>
            </property>
            <property name="disabled tool groups" code="AgG3"
                      description="Tool groups switched off for every provider (the Tools window's group switches). Turning User or Root off or on also turns the Launch Agent or Launch Daemon off or on.">
                <type type="text" list="yes"/>
                <cocoa key="disabledToolGroups"/>
            </property>
            <property name="disabled tools" code="AgG4"
                      description="Tools switched off for the Main tab's provider (the Tools window's tool buttons).">
                <type type="text" list="yes"/>
                <cocoa key="disabledTools"/>
            </property>
            <property name="mcp servers" code="AgX1" access="r"
                      description="Every MCP server name, as in the MCP Servers window.">
                <type type="text" list="yes"/>
                <cocoa key="mcpServers"/>
            </property>
            <property name="enabled mcp servers" code="AgX2"
                      description="MCP servers switched on (the MCP Servers window's switches). Switching one on connects it; switching it off disconnects it.">
                <type type="text" list="yes"/>
                <cocoa key="enabledMCPServers"/>
            </property>
            <property name="connected mcp servers" code="AgX3" access="r"
                      description="MCP servers connected right now.">
                <type type="text" list="yes"/>
                <cocoa key="connectedMCPServers"/>
            </property>
            <property name="mcp tools" code="AgX4" access="r"
                      description="Every tool of the connected MCP servers, as server.tool.">
                <type type="text" list="yes"/>
                <cocoa key="mcpTools"/>
            </property>
            <property name="disabled mcp tools" code="AgX5"
                      description="MCP tools switched off (the MCP Servers window's tool buttons), as server.tool.">
                <type type="text" list="yes"/>
                <cocoa key="disabledMCPTools"/>
            </property>
            <property name="llm output" code="AgLO" type="text" access="r"
                      description="Text of the Main tab's LLM Output pane (the LLM's latest response).">
                <cocoa key="llmOutput"/>
            </property>
            <property name="input tokens" code="AgKI" type="integer" access="r"
                      description="Input tokens of the Main tab's current or last task.">
                <cocoa key="inputTokens"/>
            </property>
            <property name="output tokens" code="AgKO" type="integer" access="r"
                      description="Output tokens of the Main tab's current or last task.">
                <cocoa key="outputTokens"/>
            </property>
            <property name="session input tokens" code="AgKi" type="integer" access="r"
                      description="Input tokens used since Agent! launched (or since clear tokens).">
                <cocoa key="sessionInputTokens"/>
            </property>
            <property name="session output tokens" code="AgKo" type="integer" access="r"
                      description="Output tokens used since Agent! launched (or since clear tokens).">
                <cocoa key="sessionOutputTokens"/>
            </property>
            <element type="tab" description="Tabs in tab-bar order. tab 1 is always the Main tab.">
                <cocoa key="scriptingTabs"/>
            </element>
        </class-extension>

        <class name="tab" plural="tabs" code="AgTb" description="A tab. Use make new tab to open an LLM tab with the Main tab's provider and model.">
            <cocoa class="ScriptingTab"/>
            <property name="id" code="ID  " type="text" access="r"
                      description="Unique identifier (&quot;main&quot; for the Main tab).">
                <cocoa key="uniqueID"/>
            </property>
            <property name="name" code="pnam" type="text" access="r" description="Tab title.">
                <cocoa key="name"/>
            </property>
            <property name="task running" code="AgRn" type="boolean" access="r"
                      description="Whether the tab is running a task.">
                <cocoa key="taskRunning"/>
            </property>
            <property name="activity log" code="AgLg" type="text" access="r"
                      description="Full text of the tab's activity log.">
                <cocoa key="activityLog"/>
            </property>
            <property name="task input" code="AgTI" type="text" description="The tab's task field text.">
                <cocoa key="taskInput"/>
            </property>
            <property name="project folder" code="AgPF" type="text" description="The tab's project folder (absolute path).">
                <cocoa key="projectFolder"/>
            </property>
            <property name="provider" code="AgPv" type="text"
                      description="Display name of the tab's LLM provider. Settable for the Main tab, or in make new tab with properties; other tabs keep the provider they were created with.">
                <cocoa key="providerName"/>
            </property>
            <property name="model" code="AgMd" type="text"
                      description="The tab's LLM model ID. Settable like provider.">
                <cocoa key="modelName"/>
            </property>
            <property name="selected" code="AgSl" type="boolean"
                      description="Whether this is the selected tab. Set to true to select it.">
                <cocoa key="selected"/>
            </property>
            <property name="auto pilot running" code="AgAR" type="boolean" access="r"
                      description="Whether an auto-pilot session is active in the tab.">
                <cocoa key="autoPilotRunning"/>
            </property>
            <property name="auto pilot goal" code="AgAG" type="text" access="r"
                      description="Goal of the tab's auto-pilot session (empty when none, or while the goal is still being asked).">
                <cocoa key="autoPilotGoal"/>
            </property>
            <property name="auto pilot cycle" code="AgAC" type="integer" access="r"
                      description="Current auto-pilot cycle number (0 when no session).">
                <cocoa key="autoPilotCycle"/>
            </property>
            <property name="auto pilot status" code="AgAS" type="text" access="r"
                      description="One-line auto-pilot status: cycle, elapsed, time left, branch, goal.">
                <cocoa key="autoPilotStatus"/>
            </property>
            <property name="task summary" code="AgLR" type="text" access="r"
                      description="Completion summary of the tab's most recent task (empty while running, after a stop, or before any task).">
                <cocoa key="lastResult"/>
            </property>
            <property name="task error" code="AgLE" type="text" access="r"
                      description="Last error logged by the tab's most recent task (empty when none).">
                <cocoa key="lastError"/>
            </property>
            <property name="prompt history" code="AgHp" access="r"
                      description="Prompts submitted in the tab, oldest first (the task field's ↑ history).">
                <type type="text" list="yes"/>
                <cocoa key="promptHistory"/>
            </property>
            <property name="task history" code="AgHt" access="r"
                      description="Recent task summaries (LLM tabs share the Main tab's), &quot;[time] prompt → summary&quot;, oldest first (History window, Task Summaries).">
                <type type="text" list="yes"/>
                <cocoa key="taskHistory"/>
            </property>
            <property name="error history" code="AgHe" access="r"
                      description="Recent errors (LLM tabs share the Main tab's), &quot;[time] type: message&quot;, oldest first (History window, Error History).">
                <type type="text" list="yes"/>
                <cocoa key="errorHistory"/>
            </property>
            <property name="queued tasks" code="AgQd" access="r"
                      description="Prompts waiting to run after the current task, in order.">
                <type type="text" list="yes"/>
                <cocoa key="queuedTasks"/>
            </property>
            <property name="llm output" code="AgLO" type="text" access="r"
                      description="Text of the tab's LLM Output pane (the LLM's latest response).">
                <cocoa key="llmOutput"/>
            </property>
            <property name="input tokens" code="AgKI" type="integer" access="r"
                      description="Input tokens of the tab's current or last task (Main), or of the tab since its log was last cleared.">
                <cocoa key="inputTokens"/>
            </property>
            <property name="output tokens" code="AgKO" type="integer" access="r"
                      description="Output tokens, counted like input tokens.">
                <cocoa key="outputTokens"/>
            </property>
            <responds-to command="clear llm output">
                <cocoa method="handleClearLLMOutputScriptCommand:"/>
            </responds-to>
            <responds-to command="clear tokens">
                <cocoa method="handleClearTokensScriptCommand:"/>
            </responds-to>
            <responds-to command="close">
                <cocoa method="handleCloseScriptCommand:"/>
            </responds-to>
            <responds-to command="select">
                <cocoa method="handleSelectScriptCommand:"/>
            </responds-to>
            <responds-to command="clear log">
                <cocoa method="handleClearLogScriptCommand:"/>
            </responds-to>
            <responds-to command="stop task">
                <cocoa method="handleStopTaskScriptCommand:"/>
            </responds-to>
            <responds-to command="clear queue">
                <cocoa method="handleClearQueueScriptCommand:"/>
            </responds-to>
            <responds-to command="stop auto pilot">
                <cocoa method="handleStopAutoPilotScriptCommand:"/>
            </responds-to>
        </class>

        <command name="run task" code="AgntRunT" description="Run a task. Returns true if the task started.">
            <cocoa class="AgentRunTaskCommand"/>
            <direct-parameter type="text" description="The task prompt."/>
            <parameter name="in folder" code="AgFd" type="text" optional="yes"
                       description="Project folder to set before running.">
                <cocoa key="folder"/>
            </parameter>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to run in (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
            <result type="boolean"/>
        </command>

        <command name="queue task" code="AgntQueT" description="Run a task now if the tab is idle, otherwise add it to the tab's queue (same as submitting while a task runs). Returns its queue position, 0 when it started now.">
            <cocoa class="AgentQueueTaskCommand"/>
            <direct-parameter type="text" description="The task prompt."/>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to queue in (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
            <result type="integer"/>
        </command>

        <command name="clear queue" code="AgntClrQ" description="Remove a tab's queued tasks; the running task keeps going. Returns how many were removed.">
            <cocoa class="AgentClearQueueCommand"/>
            <direct-parameter type="tab" optional="yes" description="Tab whose queue to clear, e.g. clear queue tab 2 (default: the Main tab)."/>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab whose queue to clear (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
            <result type="integer"/>
        </command>

        <enumeration name="history kind" code="AgHk">
            <enumerator name="prompts" code="AgKP" description="Prompt history."/>
            <enumerator name="task summaries" code="AgKS" description="Task history."/>
            <enumerator name="errors" code="AgKE" description="Error history."/>
        </enumeration>
        <command name="clear history" code="AgntClrH" description="Clear one kind of history, like the History window's Clear button. Returns how many entries were removed.">
            <cocoa class="AgentClearHistoryCommand"/>
            <direct-parameter type="history kind" description="prompts, task summaries or errors."/>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab whose history to clear (default: the Main tab). Task summaries and errors of LLM tabs are shared with the Main tab.">
                <cocoa key="tab"/>
            </parameter>
            <result type="integer"/>
        </command>
        <command name="stop task" code="AgntStpT" description="Stop a running task.">
            <cocoa class="AgentStopTaskCommand"/>
            <direct-parameter type="tab" optional="yes" description="Tab to stop, e.g. stop task tab 2 (default: the Main tab)."/>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to stop (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
        </command>

        <command name="clear log" code="AgntClrL" description="Clear a tab's activity log.">
            <cocoa class="AgentClearLogCommand"/>
            <direct-parameter type="tab" optional="yes" description="Tab to clear, e.g. clear log tab 2 (default: the Main tab)."/>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to clear (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
        </command>

        <command name="reset system prompt" code="AgntRsSP" description="Restore the built-in system prompt (Settings &gt; System Prompt &gt; Reset to Default).">
            <cocoa class="AgentResetSystemPromptCommand"/>
            <parameter name="compact" code="AgCp" type="boolean" optional="yes"
                       description="true: reset the Apple AI compact prompt instead of the full one.">
                <cocoa key="compact"/>
            </parameter>
        </command>

        <command name="store api key" code="AgntSAPK" description="Save a provider's API key (the API Key field in Settings, kept in the Keychain). Keys can't be read back. An empty key clears it.">
            <cocoa class="AgentStoreAPIKeyCommand"/>
            <direct-parameter type="text" description="The API key."/>
            <parameter name="for provider" code="AgPk" type="text"
                       description="Provider name as in the provider menu, e.g. OpenAI, OpenRouter, LM Studio.">
                <cocoa key="provider"/>
            </parameter>
        </command>
        <command name="fm server" code="AgntFMsv" description="Start, stop, restart or check the Apple fm serve server (the Server row in Settings). Waits for the action and returns whether the server is running.">
            <cocoa class="AgentFMServerCommand"/>
            <direct-parameter type="text" optional="yes" description="start, stop, restart or status (default: status)."/>
            <result type="boolean" description="True when the server is running."/>
        </command>
        <command name="clear llm output" code="AgntClrO" description="Clear a tab's LLM Output pane (Shortcuts &gt; Clear LLM Output).">
            <cocoa class="AgentClearLLMOutputCommand"/>
            <direct-parameter type="tab" optional="yes" description="Tab to clear, e.g. clear llm output tab 2 (default: the Main tab)."/>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to clear (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
        </command>

        <command name="clear tokens" code="AgntClrK" description="Reset token counts (Shortcuts &gt; Clear Tokens). For the Main tab this resets the task and session counts.">
            <cocoa class="AgentClearTokensCommand"/>
            <direct-parameter type="tab" optional="yes" description="Tab to reset, e.g. clear tokens tab 2 (default: the Main tab)."/>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to reset (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
        </command>

        <command name="start auto pilot" code="AgntStAP" description="Start an auto-pilot session: the tab works in cycles until the goal is reached, the time limit runs out, or it is stopped. Same as /auto. Returns true if it started.">
            <cocoa class="AgentStartAutoPilotCommand"/>
            <direct-parameter type="text" optional="yes" description="The goal. Omit to have Agent! review the project and ask for one."/>
            <parameter name="hours" code="AgHr" type="real" optional="yes"
                       description="Time limit in hours (default: no limit).">
                <cocoa key="hours"/>
            </parameter>
            <parameter name="isolated" code="AgIs" type="boolean" optional="yes"
                       description="true: work in an isolated git worktree; false: the shared checkout (default: isolate only when another auto-pilot tab is on the project).">
                <cocoa key="isolated"/>
            </parameter>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to run in (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
            <result type="boolean"/>
        </command>
        <command name="stop auto pilot" code="AgntSpAP" description="End a tab's auto-pilot session. By default it ends now and stops the running task (Stop All); with after cycle true it ends when the current cycle finishes (/auto stop).">
            <cocoa class="AgentStopAutoPilotCommand"/>
            <direct-parameter type="tab" optional="yes" description="Tab to stop, e.g. stop auto pilot tab 2 (default: the Main tab)."/>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to stop (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
            <parameter name="after cycle" code="AgAf" type="boolean" optional="yes"
                       description="true: let the running cycle finish first.">
                <cocoa key="afterCycle"/>
            </parameter>
        </command>
        <command name="memory" code="AgntMemo" description="Read or edit Agent!'s memory, the same /memories files the agent's memory tool uses. Returns the result text; failures raise an error.">
            <cocoa class="AgentMemoryCommand"/>
            <direct-parameter type="text" description="view, create, str_replace, insert, delete or rename."/>
            <parameter name="path" code="AgYp" type="text" optional="yes"
                       description="A path under /memories, e.g. &quot;/memories/notes.md&quot; (default: /memories).">
                <cocoa key="path"/>
            </parameter>
            <parameter name="content" code="AgYc" type="text" optional="yes"
                       description="create: the whole file; insert: the lines to insert.">
                <cocoa key="content"/>
            </parameter>
            <parameter name="find text" code="AgYf" type="text" optional="yes"
                       description="str_replace: the exact text to replace (must appear once).">
                <cocoa key="findText"/>
            </parameter>
            <parameter name="replacement" code="AgYr" type="text" optional="yes"
                       description="str_replace: the new text.">
                <cocoa key="replacement"/>
            </parameter>
            <parameter name="line number" code="AgYl" type="integer" optional="yes"
                       description="insert: insert before this 0-based line (0 = top).">
                <cocoa key="lineNumber"/>
            </parameter>
            <parameter name="destination" code="AgYd" type="text" optional="yes"
                       description="rename: the new path under /memories.">
                <cocoa key="destination"/>
            </parameter>
            <parameter name="project scope" code="AgYs" type="boolean" optional="yes"
                       description="true: the Main tab's project memory; false: global memory shared by every project (default).">
                <cocoa key="projectScope"/>
            </parameter>
            <result type="text"/>
        </command>
        <command name="call tool" code="AgntCalT" description="Run one of the agent's tools directly, without the LLM, and return its result text. Runs on the Main tab unless a tab is given. Same tool names and arguments the agent uses (call tool &quot;list_tools&quot; lists them). Root shell needs launch daemon enabled.">
            <cocoa class="AgentCallToolCommand"/>
            <direct-parameter type="text" description="Tool name, e.g. git, file, user_shell, xcode, list_tools."/>
            <parameter name="with input" code="AgCi" type="text" optional="yes"
                       description="The tool's arguments as a JSON object, e.g. {&quot;action&quot;:&quot;status&quot;}.">
                <cocoa key="input"/>
            </parameter>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to run the tool in, with that tab's project folder and log (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
            <result type="text"/>
        </command>
        <command name="select" code="miscslct" description="Make a tab the selected tab.">
            <cocoa class="NSScriptCommand"/>
            <direct-parameter type="tab" description="The tab to select."/>
        </command>

    </suite>
</dictionary>
