<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Agent! Terminology" xmlns:xi="http://www.w3.org/2003/XInclude">

    <!-- Standard Suite (open, close, quit, count, exists, get/set, windows …) -->
    <xi:include href="file:///System/Library/ScriptingDefinitions/CocoaStandard.sdef" xpointer="xpointer(/dictionary/suite)"/>

    <suite name="Agent! Suite" code="Agnt" description="Control Agent! — run and stop tasks, read the activity log, set the project folder.">

        <class-extension extends="application" description="Agent! application.">
            <property name="task running" code="AgRn" type="boolean" access="r"
                      description="Whether the Main tab is currently running a task.">
                <cocoa key="taskRunning"/>
            </property>
            <property name="activity log" code="AgLg" type="text" access="r"
                      description="Full text of the Main tab activity log.">
                <cocoa key="activityLog"/>
            </property>
            <property name="project folder" code="AgPF" type="text"
                      description="The Main tab project folder (absolute path).">
                <cocoa key="projectFolder"/>
            </property>
            <property name="task input" code="AgTI" type="text"
                      description="The Main tab task field text.">
                <cocoa key="taskInput"/>
            </property>
            <property name="provider" code="AgPv" type="text"
                      description="Display name of the Main tab LLM provider. Set it to a provider name (e.g. &quot;Claude&quot;) to switch.">
                <cocoa key="providerName"/>
            </property>
            <property name="model" code="AgMd" type="text"
                      description="The Main tab LLM model ID. Setting it changes the selected model for the Main tab's provider.">
                <cocoa key="modelName"/>
            </property>
            <element type="tab" description="Tabs in tab-bar order. tab 1 is always the Main tab.">
                <cocoa key="scriptingTabs"/>
            </element>
        </class-extension>

        <class name="tab" plural="tabs" code="AgTb" description="A tab. Use make new tab to open an LLM tab with the Main tab's provider and model.">
            <cocoa class="ScriptingTab"/>
            <property name="id" code="ID  " type="text" access="r"
                      description="Unique identifier (&quot;main&quot; for the Main tab).">
                <cocoa key="uniqueID"/>
            </property>
            <property name="name" code="pnam" type="text" access="r" description="Tab title.">
                <cocoa key="name"/>
            </property>
            <property name="task running" code="AgRn" type="boolean" access="r"
                      description="Whether the tab is running a task.">
                <cocoa key="taskRunning"/>
            </property>
            <property name="activity log" code="AgLg" type="text" access="r"
                      description="Full text of the tab's activity log.">
                <cocoa key="activityLog"/>
            </property>
            <property name="task input" code="AgTI" type="text" description="The tab's task field text.">
                <cocoa key="taskInput"/>
            </property>
            <property name="project folder" code="AgPF" type="text" description="The tab's project folder (absolute path).">
                <cocoa key="projectFolder"/>
            </property>
            <property name="provider" code="AgPv" type="text"
                      description="Display name of the tab's LLM provider. Settable for the Main tab, or in make new tab with properties; other tabs keep the provider they were created with.">
                <cocoa key="providerName"/>
            </property>
            <property name="model" code="AgMd" type="text"
                      description="The tab's LLM model ID. Settable like provider.">
                <cocoa key="modelName"/>
            </property>
            <property name="selected" code="AgSl" type="boolean"
                      description="Whether this is the selected tab. Set to true to select it.">
                <cocoa key="selected"/>
            </property>
            <property name="auto pilot running" code="AgAR" type="boolean" access="r"
                      description="Whether an auto-pilot session is active in the tab.">
                <cocoa key="autoPilotRunning"/>
            </property>
            <property name="auto pilot goal" code="AgAG" type="text" access="r"
                      description="Goal of the tab's auto-pilot session (empty when none, or while the goal is still being asked).">
                <cocoa key="autoPilotGoal"/>
            </property>
            <property name="auto pilot cycle" code="AgAC" type="integer" access="r"
                      description="Current auto-pilot cycle number (0 when no session).">
                <cocoa key="autoPilotCycle"/>
            </property>
            <property name="auto pilot status" code="AgAS" type="text" access="r"
                      description="One-line auto-pilot status: cycle, elapsed, time left, branch, goal.">
                <cocoa key="autoPilotStatus"/>
            </property>
            <property name="queued tasks" code="AgQd" access="r"
                      description="Prompts waiting to run after the current task, in order.">
                <type type="text" list="yes"/>
                <cocoa key="queuedTasks"/>
            </property>
            <responds-to command="close">
                <cocoa method="handleCloseScriptCommand:"/>
            </responds-to>
            <responds-to command="select">
                <cocoa method="handleSelectScriptCommand:"/>
            </responds-to>
            <responds-to command="clear log">
                <cocoa method="handleClearLogScriptCommand:"/>
            </responds-to>
            <responds-to command="stop task">
                <cocoa method="handleStopTaskScriptCommand:"/>
            </responds-to>
            <responds-to command="clear queue">
                <cocoa method="handleClearQueueScriptCommand:"/>
            </responds-to>
            <responds-to command="stop auto pilot">
                <cocoa method="handleStopAutoPilotScriptCommand:"/>
            </responds-to>
        </class>

        <command name="run task" code="AgntRunT" description="Run a task. Returns true if the task started.">
            <cocoa class="AgentRunTaskCommand"/>
            <direct-parameter type="text" description="The task prompt."/>
            <parameter name="in folder" code="AgFd" type="text" optional="yes"
                       description="Project folder to set before running.">
                <cocoa key="folder"/>
            </parameter>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to run in (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
            <result type="boolean"/>
        </command>

        <command name="queue task" code="AgntQueT" description="Run a task now if the tab is idle, otherwise add it to the tab's queue (same as submitting while a task runs). Returns its queue position, 0 when it started now.">
            <cocoa class="AgentQueueTaskCommand"/>
            <direct-parameter type="text" description="The task prompt."/>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to queue in (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
            <result type="integer"/>
        </command>

        <command name="clear queue" code="AgntClrQ" description="Remove a tab's queued tasks; the running task keeps going. Returns how many were removed.">
            <cocoa class="AgentClearQueueCommand"/>
            <direct-parameter type="tab" optional="yes" description="Tab whose queue to clear, e.g. clear queue tab 2 (default: the Main tab)."/>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab whose queue to clear (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
            <result type="integer"/>
        </command>

        <command name="stop task" code="AgntStpT" description="Stop a running task.">
            <cocoa class="AgentStopTaskCommand"/>
            <direct-parameter type="tab" optional="yes" description="Tab to stop, e.g. stop task tab 2 (default: the Main tab)."/>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to stop (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
        </command>

        <command name="clear log" code="AgntClrL" description="Clear a tab's activity log.">
            <cocoa class="AgentClearLogCommand"/>
            <direct-parameter type="tab" optional="yes" description="Tab to clear, e.g. clear log tab 2 (default: the Main tab)."/>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to clear (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
        </command>

        <command name="start auto pilot" code="AgntStAP" description="Start an auto-pilot session: the tab works in cycles until the goal is reached, the time limit runs out, or it is stopped. Same as /auto. Returns true if it started.">
            <cocoa class="AgentStartAutoPilotCommand"/>
            <direct-parameter type="text" optional="yes" description="The goal. Omit to have Agent! review the project and ask for one."/>
            <parameter name="hours" code="AgHr" type="real" optional="yes"
                       description="Time limit in hours (default: no limit).">
                <cocoa key="hours"/>
            </parameter>
            <parameter name="isolated" code="AgIs" type="boolean" optional="yes"
                       description="true: work in an isolated git worktree; false: the shared checkout (default: isolate only when another auto-pilot tab is on the project).">
                <cocoa key="isolated"/>
            </parameter>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to run in (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
            <result type="boolean"/>
        </command>
        <command name="stop auto pilot" code="AgntSpAP" description="End a tab's auto-pilot session. By default it ends now and stops the running task (Stop All); with after cycle true it ends when the current cycle finishes (/auto stop).">
            <cocoa class="AgentStopAutoPilotCommand"/>
            <direct-parameter type="tab" optional="yes" description="Tab to stop, e.g. stop auto pilot tab 2 (default: the Main tab)."/>
            <parameter name="in tab" code="AgTt" type="tab" optional="yes"
                       description="Tab to stop (default: the Main tab).">
                <cocoa key="tab"/>
            </parameter>
            <parameter name="after cycle" code="AgAf" type="boolean" optional="yes"
                       description="true: let the running cycle finish first.">
                <cocoa key="afterCycle"/>
            </parameter>
        </command>
        <command name="select" code="miscslct" description="Make a tab the selected tab.">
            <cocoa class="NSScriptCommand"/>
            <direct-parameter type="tab" description="The tab to select."/>
        </command>

    </suite>
</dictionary>
