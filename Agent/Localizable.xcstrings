    "Unchecked recipients are logged but not acted on. Each recipient must be approved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht markierte Empfänger werden protokolliert, aber nicht ausgeführt. Jeder Empfänger muss genehmigt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los destinatarios no marcados se registran pero no se ejecutan. Cada destinatario debe aprobarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les destinataires non cochés sont journalisés mais pas traités. Chaque destinataire doit être approuvé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックされていない受信者は記録されますが、応答しません。各受信者は承認が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택되지 않은 수신자는 기록되지만 응답하지 않습니다. 각 수신자는 승인을 받아야 합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщения неотмеченных получателей записываются в журнал, но не выполняются. Каждого получателя нужно одобрить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未勾选的收件人会被记录但不会响应。每个收件人都必须经过批准。"
