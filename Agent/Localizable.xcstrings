    "When the primary LLM fails 3 times, auto-switch to the next provider. Drag to reorder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt das primäre LLM 3-mal fehl, wird automatisch zum nächsten Anbieter gewechselt. Zum Neuordnen ziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el LLM principal falla 3 veces, se cambia automáticamente al siguiente proveedor. Arrastre para reordenar."
